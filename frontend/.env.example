# Todas estas variables son PÚBLICAS: Vite las copia al bundle y cualquiera las
# puede leer. Nunca pongas acá un token o una clave: el build falla si el nombre
# de una VITE_ parece un secreto (ver vite.config.ts).

# Base de la API. En desarrollo dejalo en /api/v1 y deja que el proxy de Vite
# reenvie a VITE_DEV_API_PROXY: así el navegador nunca cruza origen y CORS deja
# de ser un problema en local.
VITE_API_BASE_URL=/api/v1

# A donde apunta el proxy de desarrollo (solo lo usa vite.config.ts).
VITE_DEV_API_PROXY=http://localhost:8000

# Cadencia del polling, en milisegundos.
# El worker de correlación del backend corre cada 120 s
# (CORRELATION_POLL_INTERVAL_SECONDS). Pedir más seguido que eso gasta batería
# y no trae datos nuevos.
VITE_POLL_INTERVAL_MS=60000

# Cadencia de la capa de sismos. Más lenta a propósito: el collector del USGS
# corre cada 5 min (USGS_POLL_INTERVAL_SECONDS) y un sismo no cambia de estado
# una vez ocurrido.
VITE_SEISMIC_POLL_INTERVAL_MS=180000

# Cadencia del estado meteorológico táctico de la barra superior. La escribe el
# mismo collector que la lluvia (cada 30 min, porque los modelos globales se
# recalculan cada 3 a 6 horas), pero tiene variable propia porque son dos
# consumidores con vidas distintas: la capa de lluvia sólo consulta cuando
# alguien la enciende y el widget consulta desde que arranca la aplicación.
VITE_WEATHER_POLL_INTERVAL_MS=600000

# Cadencia de la capa de lluvia pronosticada (sólo mientras está encendida).
# El collector meteorológico corre cada 30 min.
VITE_RAIN_POLL_INTERVAL_MS=600000

# Cadencia de la capa de cortes de ruta (MOP + MTT, sólo mientras está
# encendida). El MOP corre cada hora y publica sobre todo los lunes.
VITE_ROAD_CLOSURE_POLL_INTERVAL_MS=900000

# Radar de vehículos (GBV): on/off. Por defecto encendido en `npm run dev` y
# apagado en el build, hasta avisarle a GBV. Cadencia en ms (el collector corre
# cada 30 min).
VITE_VEHICLE_RADAR=
VITE_VEHICLE_POLL_INTERVAL_MS=300000

# Cortes de agua (Esval): encendido por defecto. La fila aparece sola cuando el
# backend ya leyo a Esval al menos una vez; `off` la apaga de emergencia.
# Cadencia en ms (el collector corre cada 10 min).
VITE_WATER_CUTS=
VITE_WATER_CUT_POLL_INTERVAL_MS=300000

# Antiguedad a partir de la cual la UI advierte que el dato puede no estar al dia.
VITE_STALE_AFTER_MS=180000

# Estilo del mapa base. Por defecto CARTO Positron (sin API key).
# En produccion conviene un proveedor con contrato: MapTiler, Protomaps propio, etc.
VITE_MAP_STYLE=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json

# Estilo del mapa en modo oscuro. Mismo proveedor y mismo esquema de teselas,
# así que alternar entre ambos no vuelve a descargar la geometría.
VITE_MAP_STYLE_DARK=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# Cloudflare Turnstile: clave PUBLICA del sitio (verificacion anti-bots del
# reporte ciudadano). Vacia = sin verificacion. Su secreto va en Render como
# TURNSTILE_SECRET_KEY; con una sola de las dos, los reportes fallan.
VITE_TURNSTILE_SITE_KEY=
