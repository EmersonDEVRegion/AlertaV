# Variables de PRODUCCIÓN. Este archivo es una plantilla para copiar/pegar en el
# panel de Koyeb — NO se sube al contenedor ni se versiona con valores reales.
# Ver DEPLOY.md para el detalle de cada una.

# -- Base de datos (Supabase) -------------------------------------------------
# Session pooler, puerto 5432. NO la conexión directa (db.<ref>.supabase.co):
# esa sólo resuelve en IPv6.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_SSL_MODE=require
# Sólo true si usás el pooler de transacción (puerto 6543).
DB_DISABLE_PREPARED_STATEMENTS=false
# Techo real de conexiones = (POOL_SIZE + MAX_OVERFLOW) * 2 procesos.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3

# -- Aplicación ---------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# -- CORS ---------------------------------------------------------------------
# Dominio exacto del frontend. Sin barra final.
CORS_ORIGINS=https://alertav.vercel.app
# Previews de Vercel: el subdominio cambia con cada rama.
CORS_ORIGIN_REGEX=^https://alertav-[a-z0-9-]+\.vercel\.app$

# -- Fuentes ------------------------------------------------------------------
FIRMS_MAP_KEY=<tu-map-key-de-nasa-firms>

# -- Cortes de suministro electrico -------------------------------------------
# Chilquinta cubre el Gran Valparaiso. Es autoridad sobre SU red (confianza 1.0)
# y emite type=power_outage, que cae en la familia `power`: aislada de incendios
# y accidentes.
#
# Chilquinta NO tiene API. Esto es un archivo estatico que la empresa regenera,
# y es lo unico que lee su visor. El 006 es el codigo de filial y forma parte
# del NOMBRE del archivo. El cuerpo es JSONP: envuelto en eqfeed_callback( ... ).
# No hace falta credencial: es publico.
CHILQUINTA_API_URL=https://mapainterrupciones.chilquinta.cl/dt/results_006.js
POWER_POLL_INTERVAL_SECONDS=300

# CGE: DESREGISTRADA en registry.py. La variable queda configurada y lista, pero
# el collector NO esta en rotacion: su camino KMZ esta escrito y todavia sin
# verificar contra el archivo real. Mientras siga asi, la periferia de la region
# —valle del Aconcagua, litoral y sectores rurales— no tiene capa de cortes.
#
# Esto NO es un endpoint JSON: es un KMZ (un ZIP con un KML dentro) que CGE
# regenera cada pocos minutos y sirve como estatico. Es el archivo sobre el que
# se dibuja su visor, y explica por que la raiz /afectaciones/ devolvia HTML:
# ahi no hay API que encontrar. El collector lo descarga crudo y lo descomprime
# en memoria — ver app/collectors/power/kmz_parser.py.
#
# No necesita credenciales ni cabeceras propias mas alla del Accept del binario.
CGE_API_URL=https://mapa-afectaciones.grupocge.cl/afectaciones/mapa_cge.kmz

# El worker recorta por el bounding box regional ANTES de mapear al dominio,
# reutilizando REGION_NORTH/SOUTH/EAST/WEST de mas arriba. Las distribuidoras
# publican su zona de concesion completa, asi que sin este filtro entrarian
# cortes de medio pais. Mover la caja mueve todas las capas a la vez, que es lo
# que se quiere: una sola definicion del territorio.

# -- Sismos: Centro Sismologico Nacional --------------------------------------
# El CSN es la red oficial chilena y publica desde M2.5; el feed global del USGS
# ignora en la practica casi todo lo chileno bajo M4.5. Se conservan las dos: son
# mediciones independientes del mismo fenomeno.
# Sin credenciales: es una pagina publica.
CSN_BASE_URL=https://www.sismologia.cl
# Dos dias y no uno: a las 00:30 de Chile el catalogo del dia nuevo tiene una
# fila y todo lo reciente vive en el del dia anterior.
CSN_CATALOG_DAYS=2
# 0.0 = todo lo que el CSN publique. Subirlo solo si el volumen molesta.
CSN_MIN_MAGNITUDE=0.0
CSN_POLL_INTERVAL_SECONDS=300

# -- Accidentes viales --------------------------------------------------------
# Los tres arrancan SOLO si su URL está definida. Sin ella, el collector lanza al
# construirse y deja una corrida `failed` visible en `collector_runs`: preferimos
# un error a la vista antes que una capa apagada en silencio.
#
# Waze CCP es un endpoint privado por convenio con el municipio o el gobierno
# regional; no hay URL pública.
WAZE_FEED_URL=
WAZE_ALERT_TYPES=ACCIDENT
WAZE_MAX_AGE_MINUTES=120

# Feed RSS de la central de Bomberos, via puente RSSHub.
#
# OJO: la ruta de Twitter de rsshub.app YA NO EXISTE — X cerro su API y hoy
# redirige a un 404 de Google. Este valor esta aqui como plantilla, no como algo
# que funcione. Levantar una instancia propia tampoco basta: la ruta de Twitter
# necesita credenciales que X ya no reparte. Hace falta OTRA fuente.
#
# Sintoma si se deja algo que responde pero no publica: la corrida sale
# `partial` con "no trae ninguna entrada". Antes salia `success` y la fuente
# parecia sana estando muerta.
BOMBEROS_DISPATCH_URL=https://rsshub.app/twitter/user/CentralCBV
# Se comparan por prefijo tras normalizar: 10-4 también captura 10-0-4 y 10-4-1,
# pero NO 10-40 ni 10-41.
BOMBEROS_ACCIDENT_KEYS=10-4

# Portal del MTT. En el rediseno de 2026 la region paso de RUTA a SUBDOMINIO
# (www.../valparaiso/ da 404) y los avisos viven en /estado-de-la-movilidad/,
# no en la portada. No hay API: la REST de WordPress esta deshabilitada y el
# feed RSS da error.
TRANSPORTE_INFORMA_URL=https://valparaiso.transporteinforma.cl/estado-de-la-movilidad/
TRANSPORTE_INFORMA_MAX_GEOCODES=20

# -- Redes sociales: Instagram via Apify --------------------------------------
# 🔒 Secret. Se obtiene en https://console.apify.com/settings/integrations
# Vacio = collector apagado (el constructor lanza y la corrida queda `failed`
# visible en collector_runs, que es lo que se quiere: una fuente apagada en
# silencio se olvida).
#
# El token viaja SIEMPRE en la cabecera Authorization: Bearer, nunca en la URL.
APIFY_TOKEN=
APIFY_BASE_URL=https://api.apify.com/v2
# El separador es una TILDE, no una barra.
APIFY_INSTAGRAM_ACTOR_ID=apify~instagram-scraper
# Informativo: quien raspa estas cuentas es el Schedule del Actor, en el panel
# de Apify. Aqui estan para que collector_runs.params diga de donde vienen los
# datos que se leyeron.
APIFY_INSTAGRAM_ACCOUNTS=alertanoticiasvalparaiso
#
# ANTES DE TOCAR NADA DE LO QUE SIGUE, LA CUENTA QUE IMPORTA:
#
# Apify cobra POR RESULTADO RASPADO (~1,5 USD / 1.000 posts en planes de pago),
# y cobra igual por un post ya procesado que por uno nuevo. Lo unico que mueve
# la factura es `resultsLimit` del Actor y la cadencia de su Schedule:
#
#   3 cuentas x 10 posts x 288 corridas/dia (cada 5 min)  = ~390 USD/mes
#   3 cuentas x  5 posts x  96 corridas/dia (cada 15 min) = ~65  USD/mes
#
# Ninguna variable de este archivo baja ese numero. El delta fetching del worker
# ahorra tokens de Gemini y llamadas a Nominatim, que es OTRO presupuesto.
#
# Recomendado en el Schedule del Actor: cada 15 min, resultsLimit 5 por cuenta.
#
# Cuantos items del dataset se MIRAN por corrida (leer es gratis).
APIFY_MAX_ITEMS=50
# Antiguedad maxima de la ultima corrida EXITOSA del Actor antes de avisar.
# Cubre el fallo silencioso de esta arquitectura: si el Schedule se rompe, Apify
# sigue sirviendo el dataset de la ultima corrida buena y el collector reportaria
# `success` con 0 eventos para siempre. Debe ser holgadamente mayor que la
# cadencia del Schedule (15 min -> 45 aqui).
APIFY_MAX_RUN_AGE_MINUTES=45
# Antiguedad maxima de un post para considerarlo descripcion del presente.
INSTAGRAM_MAX_AGE_MINUTES=180
# Tope de geocodificaciones por corrida. El limitador de Nominatim es global al
# proceso: este presupuesto se COMPARTE con TRANSPORTE_INFORMA_MAX_GEOCODES.
INSTAGRAM_MAX_GEOCODES=15
# 0.35 es el techo de la banda de social_media en confidence.py (max_weight).
# Subirlo aqui no sube la confianza: el motor recorta igual y solo quedaria en
# raw_events un numero que nadie respeta.
INSTAGRAM_CONFIDENCE=0.35

# -- Meteorología: lluvia y riesgo de inundación ------------------------------
# Open-Meteo, nivel abierto: sin credencial, 10.000 llamadas/día, uso no
# comercial y atribución CC BY 4.0. Las 36 comunas viajan en UNA petición
# (latitude y longitude aceptan listas), así que una corrida cuesta 1 llamada.
OPENMETEO_URL=https://api.open-meteo.com/v1/forecast
OPENMETEO_MODEL=best_match
OPENMETEO_FORECAST_DAYS=2
OPENMETEO_WINDOW_HOURS=24
# Vacío = las 36 comunas continentales de weather/comunas.py. Formato
# nombre|lat|lon separando varias con ';'.
OPENMETEO_COMUNAS=
# Umbrales de riesgo_inundacion. Cualquiera de los tres levanta el flag.
# NO son umbrales oficiales de la DMC ni de SENAPRED: son una hipótesis
# calibrable. La forma de fijarlos es cruzar esta capa con los avisos de vía
# cortada de Transporte Informa a lo largo de un invierno.
OPENMETEO_INTENSITY_MM_H=5.0
OPENMETEO_ACCUM_3H_MM=15.0
OPENMETEO_ACCUM_24H_MM=40.0
# Piso de ingesta: por debajo de esto la comuna no genera evento. Sin él, 36
# comunas x 48 corridas al día llenarían raw_events de filas que dicen "no
# llovió".
OPENMETEO_MIN_INGEST_MM=0.2

# -- Gemini: extracción de calles desde texto libre ---------------------------
# 🔒 Secret. Se obtiene en https://aistudio.google.com/apikey
# Vacía = la extracción cae a la heurística de reglas y lo deja anotado en cada
# señal (raw_data._extraction.mode). No apaga el collector.
GEMINI_API_KEY=
# Modelo ESTABLE, no un alias `-latest`: latest se intercambia solo con cada
# versión nueva y un cambio de comportamiento del extractor llegaría a
# producción sin que nadie desplegara nada.
# OJO: gemini-1.5-flash está retirado desde 2026 y responde 404.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_CALLS_PER_RUN=25
# 0 = extracción determinista. Con temperatura alta el modelo "mejora" los
# nombres de calle, que es exactamente lo que no debe hacer.
GEMINI_TEMPERATURE=0.0

# -- Nominatim (OpenStreetMap) ------------------------------------------------
# NO bajar de 1.0: la política de uso permite 1 req/s por IP y el castigo por
# excederla es el bloqueo de la IP, no un 429 reintentable.
NOMINATIM_MIN_INTERVAL_SECONDS=1.0
# Obligatorio y con contacto real: Nominatim rechaza las peticiones anónimas.
NOMINATIM_USER_AGENT=AlertaV/0.1 (contacto: TU_CORREO)
# USGS no requiere credenciales; el feed por defecto sirve tal cual.
USGS_SOURCES=geojson|https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/2.5_day.geojson

# -- Cadencias ----------------------------------------------------------------
# Espaciadas respecto de los defaults: 0.1 vCPU no da para más.
CONAF_POLL_INTERVAL_SECONDS=600
SENAPRED_POLL_INTERVAL_SECONDS=900
FIRMS_POLL_INTERVAL_SECONDS=1800
# El feed del USGS es un archivo estatico de ~50 KB: 5 min no pesa.
USGS_POLL_INTERVAL_SECONDS=300
# Los modelos globales se recalculan cada 3-6 h: preguntar cada 5 min devolveria
# 35 veces el mismo numero. 30 min = 48 llamadas/dia de las 10.000 disponibles.
OPENMETEO_POLL_INTERVAL_SECONDS=1800
CORRELATION_POLL_INTERVAL_SECONDS=300

# -- Orquestador --------------------------------------------------------------
# Las migraciones se aplican a mano desde el equipo local (DEPLOY.md §1.4).
RUN_MIGRATIONS=0
# combined: recolección y correlación en un solo intérprete (~46 MB menos).
# split:    un proceso por motor, como en desarrollo. Útil para depurar.
WORKER_MODE=combined
# Interruptores de emergencia si la instancia se queda sin memoria.
# De los dos, apagar la correlación es el mal menor: es idempotente y se pone al
# día sola. Lo que no se recolectó a tiempo, en cambio, se perdió.
ENABLE_COLLECTORS=1
ENABLE_CORRELATION=1
