# Variables de PRODUCCIÓN. Este archivo es una plantilla para copiar/pegar en el
# panel de Koyeb — NO se sube al contenedor ni se versiona con valores reales.
# Ver DEPLOY.md para el detalle de cada una.

# -- Base de datos (Supabase) -------------------------------------------------
# Session pooler, puerto 5432. NO la conexión directa (db.<ref>.supabase.co):
# esa sólo resuelve en IPv6.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_SSL_MODE=require
# Sólo true si usás el pooler de transacción (puerto 6543).
DB_DISABLE_PREPARED_STATEMENTS=false
# Techo real de conexiones = (POOL_SIZE + MAX_OVERFLOW) * 2 procesos.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3

# -- Aplicación ---------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# -- CORS ---------------------------------------------------------------------
# Dominio exacto del frontend. Sin barra final.
CORS_ORIGINS=https://alertav.vercel.app
# Previews de Vercel: el subdominio cambia con cada rama.
CORS_ORIGIN_REGEX=^https://alertav-[a-z0-9-]+\.vercel\.app$

# -- Fuentes ------------------------------------------------------------------
FIRMS_MAP_KEY=<tu-map-key-de-nasa-firms>

# -- Cortes de suministro electrico -------------------------------------------
# Chilquinta cubre el Gran Valparaiso; CGE la periferia y el valle del Aconcagua.
# Ambas son autoridad sobre SU red (confianza 1.0) y emiten type=power_outage,
# que cae en la familia `power`: aislada de incendios y accidentes.
#
# El ?emp=006 filtra en el origen: la respuesta trae solo la empresa que nos
# interesa en vez del catalogo completo. Ese query string se conserva tal cual
# (request_response omite `params` cuando viene vacio, porque httpx lo
# reemplazaria por una query vacia y el emp=006 se perderia en silencio).
CHILQUINTA_API_URL=https://mapainterrupciones.chilquinta.cl/mapas?emp=006
CGE_API_URL=https://mapa-afectaciones.grupocge.cl/afectaciones/
POWER_POLL_INTERVAL_SECONDS=300

# Ambos workers recortan por el bounding box regional ANTES de mapear al dominio,
# reutilizando REGION_NORTH/SOUTH/EAST/WEST de mas arriba. CGE publica su zona de
# concesion completa —llega hasta Aysen— asi que sin este filtro entrarian cortes
# de medio pais. Mover la caja mueve las cinco capas a la vez, que es lo que se
# quiere: una sola definicion del territorio.

# -- Sismos: Centro Sismologico Nacional --------------------------------------
# El CSN es la red oficial chilena y publica desde M2.5; el feed global del USGS
# ignora en la practica casi todo lo chileno bajo M4.5. Se conservan las dos: son
# mediciones independientes del mismo fenomeno.
# Sin credenciales: es una pagina publica.
CSN_BASE_URL=https://www.sismologia.cl
# Dos dias y no uno: a las 00:30 de Chile el catalogo del dia nuevo tiene una
# fila y todo lo reciente vive en el del dia anterior.
CSN_CATALOG_DAYS=2
# 0.0 = todo lo que el CSN publique. Subirlo solo si el volumen molesta.
CSN_MIN_MAGNITUDE=0.0
CSN_POLL_INTERVAL_SECONDS=300

# -- Accidentes viales --------------------------------------------------------
# Los tres arrancan SOLO si su URL está definida. Sin ella, el collector lanza al
# construirse y deja una corrida `failed` visible en `collector_runs`: preferimos
# un error a la vista antes que una capa apagada en silencio.
#
# Waze CCP es un endpoint privado por convenio con el municipio o el gobierno
# regional; no hay URL pública.
WAZE_FEED_URL=
WAZE_ALERT_TYPES=ACCIDENT
WAZE_MAX_AGE_MINUTES=120

# Feed RSS de la central de Bomberos, vía puente RSSHub. La instancia pública
# (rsshub.app) es compartida y sin SLA: devuelve 429 y 503 seguido. Para operar
# conviene levantar una propia —`docker run -p 1200:1200 diygod/rsshub`— y
# apuntar acá: http://tu-rsshub:1200/twitter/user/CentralCBV
BOMBEROS_DISPATCH_URL=https://rsshub.app/twitter/user/CentralCBV
# Se comparan por prefijo tras normalizar: 10-4 también captura 10-0-4 y 10-4-1,
# pero NO 10-40 ni 10-41.
BOMBEROS_ACCIDENT_KEYS=10-4

TRANSPORTE_INFORMA_URL=https://www.transporteinforma.cl/valparaiso/
TRANSPORTE_INFORMA_MAX_GEOCODES=20

# -- Gemini: extracción de calles desde texto libre ---------------------------
# 🔒 Secret. Se obtiene en https://aistudio.google.com/apikey
# Vacía = la extracción cae a la heurística de reglas y lo deja anotado en cada
# señal (raw_data._extraction.mode). No apaga el collector.
GEMINI_API_KEY=
# Modelo ESTABLE, no un alias `-latest`: latest se intercambia solo con cada
# versión nueva y un cambio de comportamiento del extractor llegaría a
# producción sin que nadie desplegara nada.
# OJO: gemini-1.5-flash está retirado desde 2026 y responde 404.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_CALLS_PER_RUN=25
# 0 = extracción determinista. Con temperatura alta el modelo "mejora" los
# nombres de calle, que es exactamente lo que no debe hacer.
GEMINI_TEMPERATURE=0.0

# -- Nominatim (OpenStreetMap) ------------------------------------------------
# NO bajar de 1.0: la política de uso permite 1 req/s por IP y el castigo por
# excederla es el bloqueo de la IP, no un 429 reintentable.
NOMINATIM_MIN_INTERVAL_SECONDS=1.0
# Obligatorio y con contacto real: Nominatim rechaza las peticiones anónimas.
NOMINATIM_USER_AGENT=AlertaV/0.1 (contacto: TU_CORREO)
# USGS no requiere credenciales; el feed por defecto sirve tal cual.
USGS_SOURCES=geojson|https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/2.5_day.geojson

# -- Cadencias ----------------------------------------------------------------
# Espaciadas respecto de los defaults: 0.1 vCPU no da para más.
CONAF_POLL_INTERVAL_SECONDS=600
SENAPRED_POLL_INTERVAL_SECONDS=900
FIRMS_POLL_INTERVAL_SECONDS=1800
# El feed del USGS es un archivo estatico de ~50 KB: 5 min no pesa.
USGS_POLL_INTERVAL_SECONDS=300
CORRELATION_POLL_INTERVAL_SECONDS=300

# -- Orquestador --------------------------------------------------------------
# Las migraciones se aplican a mano desde el equipo local (DEPLOY.md §1.4).
RUN_MIGRATIONS=0
# combined: recolección y correlación en un solo intérprete (~46 MB menos).
# split:    un proceso por motor, como en desarrollo. Útil para depurar.
WORKER_MODE=combined
# Interruptores de emergencia si la instancia se queda sin memoria.
# De los dos, apagar la correlación es el mal menor: es idempotente y se pone al
# día sola. Lo que no se recolectó a tiempo, en cambio, se perdió.
ENABLE_COLLECTORS=1
ENABLE_CORRELATION=1
