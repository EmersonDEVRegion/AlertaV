# Variables de producción del servicio `alertav-api` en Render.
#
# Plantilla sin valores reales: se copian al panel de Render (Environment), no se
# versionan con secretos ni entran a la imagen. Todo lo que no aparece acá tiene
# un valor por defecto en `app/core/config.py`, documentado junto a cada campo;
# sólo se define en Render cuando hay que cambiarlo.
#
# Con ENVIRONMENT=production la app NO arranca si falta un secreto obligatorio o
# quedó un placeholder (ver `Settings._produccion_sin_huecos`). Render mantiene
# el despliegue anterior y el motivo sale en el log.

# -- Aplicación ----------------------------------------------------------------
ENVIRONMENT=production
# Aplica `alembic upgrade head` al arrancar.
RUN_MIGRATIONS=1
# Origen exacto de la PWA, sin barra final. Varios, separados por coma.
CORS_ORIGINS=https://alertav.vercel.app
# Rutas de operación (/collectors/*, /incidents/correlate, /moderacion y las
# lecturas crudas de /events): `Authorization: Bearer <token>`. Vacío = 503.
# Mínimo 32 caracteres: python -c "import secrets; print(secrets.token_hex(32))"
OPERATOR_TOKEN=

# -- Base de datos (Supabase) --------------------------------------------------
# Session pooler, puerto 5432. No la conexión directa (db.<ref>.supabase.co),
# que sólo resuelve en IPv6.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Techo de conexiones = (POOL_SIZE + MAX_OVERFLOW) × 2 procesos (API y workers).
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3

# -- Fuentes -------------------------------------------------------------------
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# Todas las magnitudes del último día; el filtro por zona y magnitud lo hace
# el collector (por defecto se leen sólo las ≥ 2,5).
USGS_SOURCES=geojson|https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
# Esval sólo responde a IP chilenas: proxy en Oracle (infra/proxy-cl/).
ESVAL_PROXY_URL=http://<usuario>:<clave>@<ip>:8888
# Extracción de calles desde texto libre y moderación de reportes ciudadanos.
GEMINI_API_KEY=
# Identidad ante Nominatim y los demás servicios, con un correo real.
NOMINATIM_USER_AGENT=AlertaV/1.0 (+https://github.com/EmersonDEVRegion/AlertaV; <correo>)

# -- Apify: despachos de Bomberos y tránsito por X ----------------------------
# Ver infra/apify/README.md.
APIFY_TOKEN=
# Mínimo 32 caracteres; el mismo que va en el webhook de Apify.
APIFY_WEBHOOK_SECRET=
# Tasks que pueden entregar al webhook: el principal y el canario.
APIFY_BOMBEROS_ACTOR_IDS=<task-principal>,<task-canario>
# El canario: la única entrega donde se mide la ceguera de cada cuenta.
APIFY_X_CANARIO_IDS=<task-canario>

# -- Reportes ciudadanos -------------------------------------------------------
# Sal del HMAC con que se guardan dispositivo y red. Vacía = OPERATOR_TOKEN.
CITIZEN_HASH_SALT=
# Cloudflare Turnstile, clave secreta. Vacía = sin verificación. La pública va
# en Vercel como VITE_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=

# -- Notificaciones push -------------------------------------------------------
# python scripts/generate_vapid_keys.py (la pública se deriva de esta).
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:<correo>

# -- Opcionales ----------------------------------------------------------------
# WORKER_MODE=combined            # combined | split (start.sh)
# ENABLE_COLLECTORS=1             # interruptores de emergencia del orquestador
# ENABLE_CORRELATION=1
# ENABLE_PUSH=1
# PUSH_LOCATION_MAX_AGE_HOURS=24  # la última ubicación vence; 0 = nunca
# CORRELATION_PRENSA=false        # la prensa fuera del motor
# COLLECTOR_RUNS_RETENTION_DAYS=30
# LOG_LEVEL=INFO
