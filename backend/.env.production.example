# Variables de PRODUCCIÓN. Este archivo es una plantilla para copiar/pegar en el
# panel de Koyeb — NO se sube al contenedor ni se versiona con valores reales.
# Ver DEPLOY.md para el detalle de cada una.

# -- Base de datos (Supabase) -------------------------------------------------
# Session pooler, puerto 5432. NO la conexión directa (db.<ref>.supabase.co):
# esa sólo resuelve en IPv6.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_SSL_MODE=require
# Sólo true si usás el pooler de transacción (puerto 6543).
DB_DISABLE_PREPARED_STATEMENTS=false
# Techo real de conexiones = (POOL_SIZE + MAX_OVERFLOW) * 2 procesos.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3
# Collectors corriendo a la vez en el proceso de workers. Con 2+3 conexiones,
# 4 deja una libre para la correlacion y el push. Subirlo sin subir el pool
# devuelve el `pool_timeout` del arranque.
COLLECTOR_MAX_CONCURRENCY=4

# -- Aplicación ---------------------------------------------------------------
# Con ENVIRONMENT=production la app NO ARRANCA si APIFY_WEBHOOK_SECRET tiene menos
# de 32 caracteres, si APIFY_BOMBEROS_ACTOR_IDS esta vacia, si VAPID_SUBJECT /
# FIRMS_MAP_KEY quedaron vacios o con un placeholder (TU_CORREO, example.cl,
# <...>), si NOMINATIM_USER_AGENT tiene un placeholder, o si no hay ningun correo
# de contacto (CONTACT_EMAIL, VAPID_SUBJECT o NOMINATIM_USER_AGENT). Render
# mantiene el despliegue anterior y el motivo sale en el log.
ENVIRONMENT=production
LOG_LEVEL=INFO
# Token de las rutas de operacion (/collectors/*, /incidents/correlate):
#   Authorization: Bearer <token>
# Vacio = esas rutas responden 503 (cerradas). Si se define, minimo 32 ASCII.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
OPERATOR_TOKEN=
# Correo que va en el User-Agent de TODAS las consultas a servicios ajenos, para
# que su operador sepa a quien escribir antes de bloquear la IP. Vacio = se toma
# el mailto: de VAPID_SUBJECT o el correo de NOMINATIM_USER_AGENT. En produccion
# la app no arranca si no hay ninguno.
CONTACT_EMAIL=

# -- CORS ---------------------------------------------------------------------
# Dominio exacto del frontend. Sin barra final.
CORS_ORIGINS=https://alertav.vercel.app
# Previews de Vercel: el subdominio cambia con cada rama.
CORS_ORIGIN_REGEX=^https://alertav-[a-z0-9-]+\.vercel\.app$

# -- Cadencia de los collectors -----------------------------------------------
# Dispersion aleatoria de CADA espera del bucle, como fraccion del intervalo.
# 0 = metronomo exacto (util solo para depurar: con esto encendido dos corridas
# nunca caen en el mismo segundo y comparar bitacoras cuesta).
#
# Resuelve dos cosas que el escalonado del arranque no toca:
#   * dos cadencias con divisor comun vuelven a alinearse igual (600 y 900
#     coinciden cada media hora, elija el arranque el desfase que elija);
#   * una peticion cada N segundos EXACTOS desde una IP de datacenter es la
#     firma de bot mas facil de reconocer que puede dejar un cliente.
COLLECTOR_JITTER_RATIO=0.10

# -- Fuentes ------------------------------------------------------------------
FIRMS_MAP_KEY=<tu-map-key-de-nasa-firms>

# Prensa local (collector `prensa_local`). NO LA DEFINAS EN RENDER: el default
# del codigo es la lista vigente (Alerta Noticias, Pura Noticia, Prensa Marga
# Marga, Quinta Prensa). Sitio del Suceso salio de rotacion porque Cloudflare le
# responde 403 a todo lo que no es un navegador; si Render todavia la lista en
# LOCAL_NEWS_SOURCES, cada corrida queda `partial` por ese 403. Borra la
# variable, o copia el default de app/core/config.py sin la fila sitiodelsuceso.

# -- Cortes de suministro electrico -------------------------------------------
# Chilquinta cubre el Gran Valparaiso. Es autoridad sobre SU red (confianza 1.0)
# y emite type=power_outage, que cae en la familia `power`: aislada de incendios
# y accidentes.
#
# Chilquinta NO tiene API. Esto es un archivo estatico que la empresa regenera,
# y es lo unico que lee su visor. El 006 es el codigo de filial y forma parte
# del NOMBRE del archivo. El cuerpo es JSONP: envuelto en eqfeed_callback( ... ).
# No hace falta credencial: es publico.
CHILQUINTA_API_URL=https://mapainterrupciones.chilquinta.cl/dt/results_006.js
POWER_POLL_INTERVAL_SECONDS=300

# CGE: DESREGISTRADA en registry.py. La variable queda configurada y lista, pero
# el collector NO esta en rotacion: su camino KMZ esta escrito y todavia sin
# verificar contra el archivo real. Mientras siga asi, la periferia de la region
# —valle del Aconcagua, litoral y sectores rurales— no tiene capa de cortes.
#
# Esto NO es un endpoint JSON: es un KMZ (un ZIP con un KML dentro) que CGE
# regenera cada pocos minutos y sirve como estatico. Es el archivo sobre el que
# se dibuja su visor, y explica por que la raiz /afectaciones/ devolvia HTML:
# ahi no hay API que encontrar. El collector lo descarga crudo y lo descomprime
# en memoria — ver app/collectors/power/kmz_parser.py.
#
# No necesita credenciales ni cabeceras propias mas alla del Accept del binario.
CGE_API_URL=https://mapa-afectaciones.grupocge.cl/afectaciones/mapa_cge.kmz

# El worker recorta por el bounding box regional ANTES de mapear al dominio,
# reutilizando REGION_NORTH/SOUTH/EAST/WEST de mas arriba. Las distribuidoras
# publican su zona de concesion completa, asi que sin este filtro entrarian
# cortes de medio pais. Mover la caja mueve todas las capas a la vez, que es lo
# que se quiere: una sola definicion del territorio.

# -- Sismos: Centro Sismologico Nacional --------------------------------------
# El CSN es la red oficial chilena y publica desde M2.5; el feed global del USGS
# ignora en la practica casi todo lo chileno bajo M4.5. Se conservan las dos: son
# mediciones independientes del mismo fenomeno.
# Sin credenciales: es una pagina publica.
CSN_BASE_URL=https://www.sismologia.cl
# Dos dias y no uno: a las 00:30 de Chile el catalogo del dia nuevo tiene una
# fila y todo lo reciente vive en el del dia anterior.
CSN_CATALOG_DAYS=2
# 0.0 = todo lo que el CSN publique. Subirlo solo si el volumen molesta.
CSN_MIN_MAGNITUDE=0.0
CSN_POLL_INTERVAL_SECONDS=300

# -- Accidentes viales --------------------------------------------------------
# Transporte Informa arranca SOLO si su URL está definida. Sin ella, el collector
# lanza al construirse y deja una corrida `failed` visible en `collector_runs`.
#
# Waze se borró el 2026-09-23 (el convenio de Waze for Cities nunca se aprobó).
# Si Render todavía tiene WAZE_FEED_URL, WAZE_ALERT_TYPES o WAZE_MAX_AGE_MINUTES,
# BÓRRALAS: ya no las lee nadie.

# Despachos de la central de Bomberos.
#
# El lector RSS (RSSHub) se borró el 2026-09-23. Si Render todavía tiene
# BOMBEROS_POLL_INTERVAL_SECONDS o BOMBEROS_TIMEOUT_SECONDS, BÓRRALAS.
#
# LOS DESPACHOS ENTRAN POR WEBHOOK: POST /api/v1/apify/webhook.
# Ver la seccion "Apify: webhook de entrada" mas abajo para conectarlo.
#
# Claves que se ingieren, una lista por Cuerpo: BOMBEROS_ACCIDENT_KEYS para el
# CBV (@CGI_CBV, Valparaiso) y BOMBEROS_CBVM_KEYS para el CBVM (@CBVM132, Vina
# del Mar y Concon). Son DOS sistemas de claves distintos: ver apify/README.md.
#
# NO LAS DEFINAS EN RENDER. El default del codigo sigue la tabla oficial de cada
# Cuerpo y tiene tests que lo amarran. Hasta el 2026-09-23 este archivo traia
# `BOMBEROS_ACCIDENT_KEYS=10-0,10-1,10-2,10-3,10-4,12`, que es de OTRO sistema:
# en el CBV real `10` es abastecer agua y `12` es Academia de Cuerpo (una
# capacitacion que entraba al mapa con confianza 1.00), y los choques (`5-x`)
# quedaban fuera. Si Render todavia tiene ese valor, BORRA la variable.
#
# Y ojo: definirla vacia NO vuelve al default, deja la lista vacia y no entra
# ningun despacho.
#
# Solo para ampliar a mano, con la lista completa:
# BOMBEROS_ACCIDENT_KEYS=1-1,1-2,1-3,2-1,2-2,2-3,3-1,3-2,4-1,4-2,5-1,5-2,6-1,6-2,6-3,6-4,6-5,9-1,9-2,9-3,15
# BOMBEROS_CBVM_KEYS=1-1,1-2,1-3,2-1,2-2,2-3,3,4-1,4-2,5-1,5-2,6-1,6-2,6-3,9,10,15

# Portal del MTT. En el rediseno de 2026 la region paso de RUTA a SUBDOMINIO
# (www.../valparaiso/ da 404) y los avisos viven en /estado-de-la-movilidad/,
# no en la portada. No hay API: la REST de WordPress esta deshabilitada y el
# feed RSS da error.
TRANSPORTE_INFORMA_URL=https://valparaiso.transporteinforma.cl/estado-de-la-movilidad/
TRANSPORTE_INFORMA_MAX_GEOCODES=20
# 10 min. NO bajar la frecuencia "por precaucion": la carga sobre el MTT es de
# UN GET por ciclo (144 al dia, menos que una persona mirando el portal), y esta
# fuente vale justamente por ser el canal oficial mas rapido. Lo que expone a un
# bloqueo es el PATRON, no el volumen; de eso se encarga COLLECTOR_JITTER_RATIO.
TRANSPORTE_INFORMA_POLL_INTERVAL_SECONDS=600
# 15 s, mas corto que los 30 del resto: tras el GET vienen hasta MAX_GEOCODES
# llamadas a Nominatim a 1 s cada una y la corrida tiene que caber en su ciclo.
TRANSPORTE_INFORMA_TIMEOUT_SECONDS=15
# TRANSPORTE_INFORMA_USER_AGENT, GBV_USER_AGENT, ESVAL_USER_AGENT y
# LOCAL_NEWS_USER_AGENT: NO definirlas. Vacias, cada scraper manda navegador +
# identidad del proyecto (repo y correo de contacto, ver CONTACT_EMAIL). Si
# Render tiene alguna con github.com/alertav, BORRARLA: esa organizacion no
# existe. Con valor, se manda tal cual y SIN TILDES (httpx rechaza no-ASCII).

# -- Infraestructura vial danada: MOP / Direccion de Vialidad -----------------
# ArcGIS abierto, sin credencial. La URL tiene que llevar el numero de CAPA: la
# 0 son todas las emergencias vigentes como punto. Sin el /0 devuelve los
# metadatos del servicio y cero emergencias.
#
# Capa de CONTEXTO: emite road_closure con confianza 0.0, no genera incidentes
# ni mueve la confianza de ninguno. Son rutas danadas (socavaciones, derrumbes,
# puentes restringidos), NO siniestros.
MOP_VIALIDAD_URL=https://rest-sit.mop.gob.cl/arcgis/rest/services/VIALIDAD/Emergencias_Vialidad/MapServer/0
# Una hora. El servicio se actualiza los LUNES ~15:00 y a diario solo durante
# eventos de emergencia: a 5 minutos serian 2016 peticiones por dato nuevo.
MOP_VIALIDAD_POLL_INTERVAL_SECONDS=3600

# -- Apify ----------------------------------------------------------------------
#
# Apify se usa SOLO para el Task de X de las centrales de Bomberos
# (apify/README.md). Instagram y la prensa por X se BORRARON el 2026-09-23. Si
# Render todavía tiene alguna de estas, BÓRRALAS: APIFY_INSTAGRAM_ENABLED,
# APIFY_PRENSA_ENABLED, APIFY_PRENSA_ACTOR_IDS, APIFY_INSTAGRAM_ACTOR_ID,
# APIFY_INSTAGRAM_ACCOUNTS, APIFY_MAX_ITEMS, APIFY_MAX_RUN_AGE_MINUTES,
# APIFY_POLL_INTERVAL_SECONDS, INSTAGRAM_MAX_AGE_MINUTES, INSTAGRAM_MAX_GEOCODES,
# INSTAGRAM_CONFIDENCE, DEBUG.
#
# Cada cuantos minutos corre el Schedule `alertav` en el panel de Apify. Tiene
# que ser EL MISMO valor que el Cron de apify/configurar.ps1 (el script lo
# imprime al final): la salud marca el webhook como detenido tras tres cadencias
# sin entrega. Cron por defecto: cada hora.
APIFY_X_SCHEDULE_MINUTES=60

# 🔒 Secret. Se obtiene en https://console.apify.com/settings/integrations
# Vacio = el webhook no puede leer los datasets (la corrida queda `failed`).
# El token viaja SIEMPRE en la cabecera Authorization: Bearer, nunca en la URL.
APIFY_TOKEN=
APIFY_BASE_URL=https://api.apify.com/v2

# --- Apify: webhook de entrada (despachos de Bomberos) -----------------------
#
# Esta es la unica ruta del backend que RECIBE datos empujados. Apify avisa al
# terminar una corrida del Actor de X/Twitter; el endpoint encola el aviso en
# collector_runs y el proceso de workers lee el dataset que nombra (inbox).
#
# COMO SE CONECTA, en el panel de Apify sobre el Actor de X/Twitter:
#   Integrations -> Webhooks -> Add webhook
#   Event:   ACTOR.RUN.SUCCEEDED
#   URL:     https://<host>/api/v1/apify/webhook
#   Headers: X-AlertaV-Apify-Secret: <el mismo valor de abajo>
# El payload por defecto ya trae resource.defaultDatasetId, que es lo unico que
# esta ruta necesita. NO hay que personalizar la plantilla.
#
# SOLO EL ACTOR DE X/TWITTER, Y EN UN SOLO NIVEL.
#   - Apuntar otro Actor a esta URL no da error: deja corridas verdes y vacias
#     que aparentan un webhook sano (ver APIFY_BOMBEROS_ACTOR_IDS mas abajo).
#   - Un webhook colgado del Actor dispara TAMBIEN para las corridas que lanza
#     un Task suyo. Si esta en los dos, el mismo dataset llega dos veces; el
#     inbox descarta la segunda entrega, pero conviene dejar uno solo.
#
# EN PRODUCCION ES OBLIGATORIO: con ENVIRONMENT=production la app no arranca si
# falta, si tiene menos de 32 caracteres o si no es ASCII. Sin secreto,
# cualquiera que descubra la URL puede hacer que este backend lea un dataset
# ajeno y lo ingiera como despachos de Bomberos (peso 1.00).
# Generar con: openssl rand -hex 32   (o python -c "import secrets; print(secrets.token_hex(32))")
APIFY_WEBHOOK_SECRET=
# Actors (o Tasks) autorizados a entregar por esta ruta. Vacio = cualquiera.
#
# El secreto dice QUIEN llama; esto dice QUE trae. En Apify el secreto de un
# webhook es de CUENTA —todos los del panel llevan el mismo—, asi que un segundo
# Actor apuntado a esta URL pasa la autenticacion entera y sus items entran por
# la puerta de Bomberos, que ingiere con confianza 1.00.
#
# El dano real no es la inyeccion, es el SILENCIO: los items del Actor
# equivocado no traen claves 10-x, la corrida cierra en `success` con 0
# insertados y deja una fila verde en collector_runs etiquetada
# `bomberos_apify_webhook` — que es justo la senal que se mira para saber si el
# webhook esta llegando. Un Actor ajeno disparando cada media hora la falsifica.
#
# EL VALOR NO ES `usuario~actor`: el webhook manda el id corto, tipo
# nfp1fpt5gUlBwPcor. Se saca del log del webhook aceptado (`ids_actor`), que lo
# cita listo para pegar. Admite varios separados por coma: el id del Actor y el
# del Task son distintos. EN PRODUCCION ES OBLIGATORIA: vacia, la app no arranca.
APIFY_BOMBEROS_ACTOR_IDS=
# Items a leer del dataset que anuncia el webhook, del mas nuevo al mas viejo.
APIFY_WEBHOOK_MAX_ITEMS=100
# Antiguedad maxima de un tuit para tomarlo como descripcion del presente. Una
# corrida del Actor puede arrastrar el timeline entero de la cuenta; sin este
# corte, la primera llamada llenaria el mapa de siniestros resueltos hace meses.
APIFY_WEBHOOK_MAX_AGE_MINUTES=180
# Cada cuanto el proceso de workers mira el inbox del webhook (segundos). Es la
# latencia maxima entre el aviso de Apify y el despacho en el mapa.
APIFY_INBOX_POLL_SECONDS=10
#
# QUE MIRAR EN collector_runs: el collector `bomberos_apify_webhook`. Es el
# unico lugar donde se ve si el webhook esta llegando. Cada aviso deja una fila
# en estado `running` (encolado) que el proceso de workers cierra al procesarlo;
# si los workers se reinician a mitad, la reclaman a los 15 minutos. Una fila
# `pendiente` de mas de 15 minutos pone la fuente en `failing` en
# /collectors/health: el proceso de workers esta caido o con ENABLE_COLLECTORS=0,
# y desde esta auditoria el webhook YA NO se procesa en el proceso de la API.

# -- Meteorología: lluvia y riesgo de inundación ------------------------------
# Open-Meteo, nivel abierto: sin credencial, 10.000 llamadas/día, uso no
# comercial y atribución CC BY 4.0. Las 36 comunas viajan en UNA petición
# (latitude y longitude aceptan listas), así que una corrida cuesta 1 llamada.
OPENMETEO_URL=https://api.open-meteo.com/v1/forecast
OPENMETEO_MODEL=best_match
OPENMETEO_FORECAST_DAYS=2
OPENMETEO_WINDOW_HOURS=24
# Vacío = las 36 comunas continentales de weather/comunas.py. Formato
# nombre|lat|lon separando varias con ';'.
OPENMETEO_COMUNAS=
# Umbrales de agua. La INTENSIDAD horaria describe el drenaje urbano saturándose
# (amenaza `lluvia`); los ACUMULADOS describen el suelo perdiendo infiltración,
# que es lo que hace ceder un talud (amenaza `remocion`). Dos mecanismos, dos
# respuestas. Cualquiera levanta riesgo_inundacion.
# NO son umbrales oficiales de la DMC ni de SENAPRED: son una hipótesis
# calibrable. La forma de fijarlos es cruzar esta capa con los avisos de vía
# cortada de Transporte Informa a lo largo de un invierno.
OPENMETEO_INTENSITY_MM_H=5.0
OPENMETEO_INTENSITY_CRITICAL_MM_H=10.0
OPENMETEO_ACCUM_3H_MM=15.0
OPENMETEO_ACCUM_3H_CRITICAL_MM=25.0
OPENMETEO_ACCUM_24H_MM=40.0
OPENMETEO_ACCUM_24H_CRITICAL_MM=60.0
# Piso de ingesta POR LLUVIA: por debajo de esto la comuna no genera evento por
# agua. Ya no es el único motivo de emisión — una comuna seca con UV 12 sí emite.
OPENMETEO_MIN_INGEST_MM=0.2

# -- Propagación de incendios: la regla 30-30-30 ------------------------------
# ≥30 °C, ≤30 % de humedad y ráfagas ≥30 km/h EN LA MISMA HORA. Es el tramo
# crítico, y su límite hay que decirlo: no es un índice validado, y la propia
# CONAF mostró en Laguna Verde (Valparaíso) que con 18 °C, 48 % y 20 km/h un
# incendio puede ser igual de devastador. En la costa de esta región el
# 30-30-30 casi nunca se cumple y los incendios ocurren igual.
OPENMETEO_FIRE_TEMP_C=30.0
OPENMETEO_FIRE_HUMIDITY_PCT=30.0
OPENMETEO_FIRE_GUST_KMH=30.0
# Tramo de AVISO, decisión propia y no un estándar: cubre el régimen costero en
# que esta región se quema de verdad. Queda por encima de las cifras de Laguna
# Verde a propósito — bajar hasta ahí dejaría el widget en ámbar todo el verano.
OPENMETEO_FIRE_WATCH_TEMP_C=25.0
OPENMETEO_FIRE_WATCH_HUMIDITY_PCT=40.0
OPENMETEO_FIRE_WATCH_GUST_KMH=25.0
# Ventana táctica del fuego y del viento: el horizonte de un turno operativo.
OPENMETEO_FIRE_WINDOW_HOURS=12

# -- Viento por sí solo -------------------------------------------------------
# Independiente del 30-30-30: a 60 km/h se suspende el combate aéreo y caen
# ramas sobre el tendido (la capa de cortes de luz de este mismo sistema), y a
# 80 km/h el daño estructural es esperable con o sin fuego.
OPENMETEO_GUST_WATCH_KMH=60.0
OPENMETEO_GUST_CRITICAL_KMH=80.0

# -- Calor con riesgo a la salud ---------------------------------------------
# NO es una declaración de "ola de calor": la DMC la define por percentil 90
# diario de la climatología de cada estación durante tres días consecutivos, y
# este collector no tiene esa serie ni ve tres días. Lo que mide es el riesgo
# fisiológico, que es un número absoluto: 32 °C es donde la DMC empieza a emitir
# avisos para los valles interiores de esta región y 36 °C el techo de los que
# efectivamente emitió para Valparaíso en 2026.
OPENMETEO_HEAT_WATCH_C=32.0
OPENMETEO_HEAT_CRITICAL_C=36.0
# Noche tropical. No dispara sola: AGRAVA un aviso a crítico. La carga del calor
# la produce la falta de alivio nocturno, no el pico de las 15:00.
OPENMETEO_TROPICAL_NIGHT_C=20.0
OPENMETEO_HEAT_WINDOW_HOURS=24

# -- Índice UV ----------------------------------------------------------------
# Los ÚNICOS umbrales de esta capa que son un estándar internacional: bandas
# "muy alto" (≥8) y "extremo" (≥11) del índice UV global de la OMS/OMM, idénticas
# en las escalas de la EPA y del ICNIRP. No se mueven.
OPENMETEO_UV_WATCH=8.0
OPENMETEO_UV_CRITICAL=11.0
# La ventana más corta, y ahí está la gracia: el UV sólo existe de día. 6 h
# encienden el aviso la mañana del día peligroso y lo apagan al atardecer, en
# vez de dejarlo prendido 24 h por algo que va a pasar mañana.
OPENMETEO_UV_WINDOW_HOURS=6

# -- Gemini: extracción de calles desde texto libre ---------------------------
# 🔒 Secret. Se obtiene en https://aistudio.google.com/apikey
# Vacía = la extracción cae a la heurística de reglas y lo deja anotado en cada
# señal (raw_data._extraction.mode). No apaga el collector.
GEMINI_API_KEY=
# Modelo ESTABLE, no un alias `-latest`: latest se intercambia solo con cada
# versión nueva y un cambio de comportamiento del extractor llegaría a
# producción sin que nadie desplegara nada.
# OJO: gemini-1.5-flash está retirado desde 2026 y responde 404.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_CALLS_PER_RUN=25
# 0 = extracción determinista. Con temperatura alta el modelo "mejora" los
# nombres de calle, que es exactamente lo que no debe hacer.
GEMINI_TEMPERATURE=0.0

# -- Nominatim (OpenStreetMap) ------------------------------------------------
# NO bajar de 1.0: la política de uso permite 1 req/s por IP y el castigo por
# excederla es el bloqueo de la IP, no un 429 reintentable.
NOMINATIM_MIN_INTERVAL_SECONDS=1.0
# Opcional. Vacio = AlertaV/1.0 (+<repo>; <correo de contacto>). Si se define,
# con contacto real: la app no arranca con TU_CORREO ni example.cl.
NOMINATIM_USER_AGENT=
# USGS no requiere credenciales; el feed por defecto sirve tal cual.
USGS_SOURCES=geojson|https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/2.5_day.geojson

# -- Notificaciones push -----------------------------------------------------
# Generar UNA vez con `python scripts/generate_vapid_keys.py` y no volver a
# cambiarla: cada suscripción queda atada a esta clave. Secret.
VAPID_PRIVATE_KEY=
# Contacto del emisor (RFC 8292). Los servicios de push escriben ahí antes de
# bloquear a alguien.
VAPID_SUBJECT=mailto:TU_CORREO
# Pausa los envíos sin perder a los suscritos.
PUSH_ENABLED=true
# Emergencias: a menos de 5 km, desde 30 % de confianza con al menos 2 fuentes
# distintas (o confirmadas por CONAF/Bomberos, o cortes de luz).
PUSH_INCIDENT_RADIUS_M=5000
PUSH_INCIDENT_MIN_CONFIDENCE=0.30
PUSH_INCIDENT_MIN_SOURCES=2
# Sismos: desde M 3,5 y sólo a quien esté dentro del radio de percepción.
PUSH_SEISMIC_MIN_MAGNITUDE=3.5

# -- Cadencias ----------------------------------------------------------------
# Espaciadas respecto de los defaults: 0.1 vCPU no da para más.
CONAF_POLL_INTERVAL_SECONDS=600
SENAPRED_POLL_INTERVAL_SECONDS=900
FIRMS_POLL_INTERVAL_SECONDS=1800
# El feed del USGS es un archivo estatico de ~50 KB: 5 min no pesa.
USGS_POLL_INTERVAL_SECONDS=300
# Los modelos globales se recalculan cada 3-6 h: preguntar cada 5 min devolveria
# 35 veces el mismo numero. 30 min = 48 llamadas/dia de las 10.000 disponibles.
OPENMETEO_POLL_INTERVAL_SECONDS=1800
CORRELATION_POLL_INTERVAL_SECONDS=300
# Radio, brecha y edad maxima por familia en el motor (perfiles.py). false = el
# motor anterior (un radio, ventana por timestamp): interruptor de emergencia si
# la calibracion nueva agrupa peor. Se compara con scripts/replay_correlacion.py.
CORRELATION_PERFILES=true

# -- Orquestador --------------------------------------------------------------
# Las migraciones se aplican a mano desde el equipo local (DEPLOY.md §1.4).
RUN_MIGRATIONS=0
# combined: recolección y correlación en un solo intérprete (~46 MB menos).
# split:    un proceso por motor, como en desarrollo. Útil para depurar.
WORKER_MODE=combined
# Interruptores de emergencia si la instancia se queda sin memoria.
# De los dos, apagar la correlación es el mal menor: es idempotente y se pone al
# día sola. Lo que no se recolectó a tiempo, en cambio, se perdió.
ENABLE_COLLECTORS=1
ENABLE_CORRELATION=1
# Sin claves VAPID el notificador se queda dormido solo; esto es para apagarlo
# del todo.
ENABLE_PUSH=1
